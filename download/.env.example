# متغيرات البيئة المطلوبة لتطبيق ألوان الخليج - ديكور الأفراح
# Environment Variables for Wedding Decor App

# ===== مطلوب Required =====

# رابط قاعدة البيانات PostgreSQL
# مثال: postgresql://user:password@host:5432/database_name
DATABASE_URL=postgresql://user:password@localhost:5432/wedding_decor

# مفتاح JWT لتشفير الجلسات (أي نص سري طويل)
JWT_SECRET=change-this-to-a-very-long-secret-string

# ===== اختياري Optional =====

# بيئة التشغيل
NODE_ENV=production

# منفذ التشغيل (الافتراضي 3000)
PORT=3000
