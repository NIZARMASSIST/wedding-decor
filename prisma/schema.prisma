// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// المشاريع
model Project {
  id          String   @id @default(cuid())
  name        String   // اسم المشروع بالإنجليزية
  nameAr      String?  // اسم المشروع بالعربية
  clientName  String?  // اسم العميل
  description String?  // وصف المشروع
  image       String?  // صورة المشروع
  status      String   @default("active") // active, completed, cancelled
  startDate   DateTime? // تاريخ البداية
  endDate     DateTime? // تاريخ الانتهاء
  deadline    DateTime? // الموعد النهائي
  notes       String?  // ملاحظات
  items       ProductionItem[]
  projectMaterials ProjectMaterial[] // المواد المرتبطة بالمشروع
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// الأقسام المتاحة في التصنيع
model Department {
  id          String   @id @default(cuid())
  name        String   @unique // اسم القسم: النجارة، الحدادة، الخياطة، الصبغ، الفوم، القطع الرقمي، أخرى
  nameAr      String?  // الاسم بالعربية
  color       String   @default("#6B7280") // لون القسم للتمييز
  icon        String?  // أيقونة القسم
  stages      Stage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// العناصر المراد تصنيعها
model ProductionItem {
  id              String   @id @default(cuid())
  projectId       String?  // ربط العنصر بمشروع
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name            String   // اسم العنصر
  image           String?  // صورة العنصر (base64 أو رابط)
  priority        Int      @default(1) // الأولوية (1 = أعلى أولوية)
  notes           String?  // ملاحظات
  status          String   @default("pending") // pending, in_progress, completed
  totalQuantity   Int      @default(1) // الكمية الإجمالية
  deadline        DateTime? // الموعد النهائي
  stages          Stage[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([projectId])
}

// المراحل لكل عنصر
model Stage {
  id              String   @id @default(cuid())
  itemId          String
  item            ProductionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  stageNumber     Int      // رقم المرحلة (1، 2، 3...)
  timePerUnit     Float    @default(0) // الوقت للوحدة الواحدة بالساعات
  quantity        Int      @default(1) // الكمية المطلوبة في هذه المرحلة
  estimatedTime   Float    @default(0) // الوقت الإجمالي المحسوب = timePerUnit * quantity
  shifts          Int      @default(1) // عدد الشفتات (1 = شفت واحد، 2 = شفتين)
  shift1Start     String?  // بداية الشفت الأول (مثال: 08:00)
  shift1End       String?  // نهاية الشفت الأول (مثال: 16:00)
  shift2Start     String?  // بداية الشفت الثاني (مثال: 16:00)
  shift2End       String?  // نهاية الشفت الثاني (مثال: 00:00)
  status          String   @default("pending") // pending, in_progress, completed
  startDate       DateTime? // تاريخ البداية الفعلي
  endDate         DateTime? // تاريخ الانتهاء الفعلي
  readyForNextAt  DateTime? // متى يكون جاهز للمرحلة التالية
  notes           String?  // ملاحظات على المرحلة
  attachments     Attachment[] // المرفقات (صور و PDF)
  checklist       ChecklistItem[] // قائمة الكميات
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([itemId, stageNumber])
  @@index([itemId])
  @@index([departmentId])
}

// المرفقات لكل مرحلة (صور و PDF)
model Attachment {
  id          String   @id @default(cuid())
  stageId     String
  stage       Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  fileName    String   // اسم الملف
  fileType    String   // نوع الملف: image, pdf
  fileData    String   // بيانات الملف (base64)
  fileSize    Int      // حجم الملف بالبايت
  description String?  // وصف الملف
  uploadType  String   @default("work") // work: أثناء العمل, completion: عند الانتهاء
  uploadedAt  DateTime @default(now())
  
  @@index([stageId])
}

// قائمة الكميات لكل مرحلة (Checklist)
model ChecklistItem {
  id          String    @id @default(cuid())
  stageId     String
  stage       Stage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  itemName    String    // اسم القطعة/الكمية
  quantity    Int       @default(1) // الكمية
  completed   Boolean   @default(false) // هل تم الإنجاز
  completedAt DateTime? // تاريخ الإنجاز
  completedBy String?   // من قام بالإنجاز
  notes       String?   // ملاحظات
  order       Int       @default(0) // الترتيب
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([stageId])
}

// المستخدمين
model User {
  id        String   @id @default(cuid())
  name      String   // اسم المستخدم
  email     String   @unique // البريد الإلكتروني (فريد)
  password  String   // كلمة المرور مشفرة (bcrypt)
  role      String   @default("user") // user, admin
  status    String   @default("active") // active, under_review, suspended
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// جدول الإعدادات
model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// المواد الأولية والتشغيلية
model Material {
  id            String   @id @default(cuid())
  name          String   // اسم المادة بالإنجليزية
  nameAr        String?  // اسم المادة بالعربية
  unit          String   // الوحدة (PCS, PKT, SHT, etc.)
  unitAr        String?  // الوحدة بالعربية
  category      String   // الفئة (CARPENTER, PAINTER, etc.)
  categoryAr    String?  // الفئة بالعربية
  unitPrice     Float    @default(0) // سعر الوحدة
  stockQuantity  Int      @default(0) // الكمية في المخزون
  status        String   @default("active") // active, inactive
  description   String?  // وصف المادة
  type          String   @default("raw") // raw: مواد أولية, operational: مواد تشغيلية
  projectMaterials ProjectMaterial[] // ارتباطات المشاريع
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([type])
}

// ارتباط المواد بالمشاريع
model ProjectMaterial {
  id          String   @id @default(cuid())
  projectId   String   // المشروع
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId  String   // المادة
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantity    Int      @default(0) // الكمية المطلوبة
  notes       String?  // ملاحظات
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, materialId])
  @@index([projectId])
  @@index([materialId])
}
