// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// المستخدمين
// الأدوار:
// general_manager: مدير عام - شخص واحد له الصلاحيات التامة
// executive_manager: مسؤول تنفيذي - يعدل مشاريعه فقط، لا يضيف مواد مستعملة
// supervisor: مشرف - يعدل المشاريع مع تسجيل اسمه، إشعارات للمسؤول التنفيذي والمدير العام
// store_keeper: ستور كيبر - يضيف المواد المستعملة فقط + إدارة المواد الأولية والمخزون
model User {
  id                 String   @id @default(cuid())
  name               String   // اسم المستخدم - يمكن تغييره في أي وقت
  email              String   @unique // البريد الإلكتروني (فريد)
  password           String   // كلمة المرور مشفرة (bcrypt) - للتحقق عند الدخول
  passwordEncrypted  String?  // نسخة مشفّرة (AES-256) قابلة للعكس - للصيانة/المدير العام فقط لعرض كلمة المرور
  phone              String?  // رقم الهاتف - يمكن تغييره
  role               String   @default("supervisor") // general_manager, executive_manager, supervisor, store_keeper, maintenance
  status             String   @default("active") // active, under_review, suspended
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // العلاقات
  projects       Project[]       // المشاريع التي أنشأها المستخدم
  changeLogs     ChangeLog[]     // التغييرات التي قام بها (للمشرفين)
  notifications  Notification[]  // الإشعارات المستلمة
  usedMaterials  UsedMaterial[]  // المواد المستعملة التي أضافتها (للستور كيبر)
  conversationParticipants ConversationParticipant[]
  sentMessages   Message[]
  messageReads   MessageRead[]
}

// المشاريع
model Project {
  id                String   @id @default(cuid())
  name              String   // اسم المشروع بالإنجليزية (يُنشأ تلقائياً من التاريخ)
  nameAr            String?  // اسم المشروع بالعربية
  projectDate       DateTime? // تاريخ المشروع
  location          String?  // مكان المشروع
  recipient         String?  // شخص المستقبل المشروع
  executiveManager  String?  // المسؤول التنفيذي للمشروع
  clientName        String?  // اسم العميل
  description       String?  // وصف المشروع
  image             String?  // صورة المشروع
  status            String   @default("active") // active, completed, cancelled
  startDate         DateTime? // تاريخ بداية تنفيذ المشروع
  endDate           DateTime? // تاريخ نهاية تنفيذ المشروع
  deadline          DateTime? // الموعد النهائي
  notes             String?  // ملاحظات
  notesAuthor       String?  // اسم كاتب الملاحظات
  createdById       String   @default("unknown") // من أنشأ المشروع - فقط هو يستطيع التعديل
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // العلاقات
  createdBy         User             @relation(fields: [createdById], references: [id])
  units             Unit[]           // الوحدات التابعة للمشروع (كل وحدة تضم عناصرها)
  items             ProductionItem[]
  projectMaterials  ProjectMaterial[] // المواد المطلوبة للمشروع (يضيفها منشئ المشروع فقط)
  usedMaterials     UsedMaterial[]   // المواد المستعملة في المشروع (يضيفها الستور كيبر فقط)
  stockTransactions StockTransaction[] // حركات المخزون المرتبطة بالمشروع
  changeLogs        ChangeLog[]
  notifications     Notification[]
}

// الوحدات التابعة لكل مشروع - كل وحدة تضم مجموعة عناصر (ProductionItem)
// الوحدة قسم منطقي داخل المشروع: مثلاً "وحدة المدخل"، "وحدة المنصة"، "وحدة الإضاءة"
model Unit {
  id           String   @id @default(cuid())
  projectId    String   // المشروع الذي تنتمي إليه الوحدة
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String   // اسم الوحدة
  nameAr       String?  // اسم الوحدة بالعربية (اختياري)
  description  String?  // وصف مختصر للوحدة
  mainImage    String?  // الصورة الرئيسية للوحدة (URL)
  subImages    String[] // صور فرعية إضافية (مصفوفة URLs) - @default([])
  order        Int      @default(0) // ترتيب الوحدة داخل المشروع
  status       String   @default("active") // active, completed, cancelled
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // العناصر المرتبطة بالوحدة
  items       ProductionItem[]

  @@index([projectId])
}

// الأقسام المتاحة في التصنيع
model Department {
  id          String   @id @default(cuid())
  name        String   @unique // اسم القسم: النجارة، الحدادة، الخياطة، الصبغ، الفوم، القطع الرقمي، أخرى
  nameAr      String?  // الاسم بالعربية
  color       String   @default("#6B7280") // لون القسم للتمييز
  icon        String?  // أيقونة القسم
  stages      Stage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// العناصر المراد تصنيعها
model ProductionItem {
  id              String   @id @default(cuid())
  projectId       String?  // ربط العنصر بمشروع
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  unitId          String?  // ربط العنصر بوحدة داخل المشروع (اختياري)
  unit            Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  name            String   // اسم العنصر
  image           String?  // صورة العنصر (base64 أو رابط)
  priority        Int      @default(1) // الأولوية (1 = أعلى أولوية)
  notes           String?  // ملاحظات
  status          String   @default("pending") // pending, in_progress, completed
  totalQuantity   Int      @default(1) // الكمية الإجمالية
  deadline        DateTime? // الموعد النهائي
  stages          Stage[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([projectId])
  @@index([unitId])
}

// المراحل لكل عنصر
model Stage {
  id              String   @id @default(cuid())
  itemId          String
  item            ProductionItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  stageNumber     Int      // رقم المرحلة (1، 2، 3...)
  timePerUnit     Float    @default(0) // الوقت للوحدة الواحدة بالساعات
  quantity        Int      @default(1) // الكمية المطلوبة في هذه المرحلة
  estimatedTime   Float    @default(0) // الوقت الإجمالي المحسوب = timePerUnit * quantity
  shifts          Int      @default(1) // عدد الشفتات (1 = شفت واحد، 2 = شفتين)
  shift1Start     String?  // بداية الشفت الأول (مثال: 08:00)
  shift1End       String?  // نهاية الشفت الأول (مثال: 16:00)
  shift2Start     String?  // بداية الشفت الثاني (مثال: 16:00)
  shift2End       String?  // نهاية الشفت الثاني (مثال: 00:00)
  status          String   @default("pending") // pending, in_progress, completed
  startDate       DateTime? // تاريخ البداية الفعلي
  endDate         DateTime? // تاريخ الانتهاء الفعلي
  readyForNextAt  DateTime? // متى يكون جاهز للمرحلة التالية
  notes           String?  // ملاحظات على المرحلة
  attachments     Attachment[] // المرفقات (صور و PDF)
  checklist       ChecklistItem[] // قائمة الكميات
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([itemId, stageNumber])
  @@index([itemId])
  @@index([departmentId])
}

// المرفقات لكل مرحلة (صور و PDF)
model Attachment {
  id          String   @id @default(cuid())
  stageId     String
  stage       Stage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  fileName    String   // اسم الملف
  fileType    String   // نوع الملف: image, pdf
  fileData    String   // بيانات الملف (base64)
  fileSize    Int      // حجم الملف بالبايت
  description String?  // وصف الملف
  uploadType  String   @default("work") // work: أثناء العمل, completion: عند الانتهاء
  uploadedAt  DateTime @default(now())
  
  @@index([stageId])
}

// قائمة الكميات لكل مرحلة (Checklist)
model ChecklistItem {
  id          String    @id @default(cuid())
  stageId     String
  stage       Stage     @relation(fields: [stageId], references: [id], onDelete: Cascade)
  itemName    String    // اسم القطعة/الكمية
  quantity    Int       @default(1) // الكمية
  completed   Boolean   @default(false) // هل تم الإنجاز
  completedAt DateTime? // تاريخ الإنجاز
  completedBy String?   // من قام بالإنجاز
  notes       String?   // ملاحظات
  order       Int       @default(0) // الترتيب
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([stageId])
}

// جدول الإعدادات
model Settings {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

// المواد الأولية والتشغيلية
// إدارة المخزون: المدير العام + الستور كيبر فقط
model Material {
  id            String   @id @default(cuid())
  name          String   // اسم المادة بالإنجليزية
  nameAr        String?  // اسم المادة بالعربية
  itemCode      String?  @unique // كود المادة (مثل 541101840001) - فريد
  unit          String   // الوحدة (PCS, PKT, SHT, Mtr, GAL, BDL, etc.)
  unitAr        String?  // الوحدة بالعربية
  category      String   // الفئة (CARPENTER, PAINTER, etc.)
  categoryAr    String?  // الفئة بالعربية
  department    String?  // القسم (CARPENTER, TAILOR WORK, PAINTER, STEEL FABRICATION, GENERAL WORK, PARKE)
  unitPrice     Float    @default(0) // سعر الوحدة (آخر سعر شراء)
  stockQuantity  Float    @default(0) // الكمية في المخزون (الرصيد الفعلي)
  minStockLevel Float?   // الحد الأدنى للتنبيه
  status        String   @default("active") // active, inactive
  description   String?  // وصف المادة
  type          String   @default("raw") // raw: مواد أولية, operational: مواد تشغيلية
  projectMaterials ProjectMaterial[] // ارتباطات المشاريع (المواد المطلوبة)
  usedMaterials    UsedMaterial[]    // ارتباطات المواد المستعملة
  stockTransactions StockTransaction[] // حركات المخزون المرتبطة
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([type])
  @@index([department])
}

// المواد المطلوبة للمشروع - يضيفها منشئ المشروع فقط
model ProjectMaterial {
  id          String   @id @default(cuid())
  projectId   String   // المشروع
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId  String   // المادة
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantity    Int      @default(0) // الكمية المطلوبة
  notes       String?  // ملاحظات
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, materialId])
  @@index([projectId])
  @@index([materialId])
}

// المواد المستعملة في المشروع - يضيفها الستور كيبر فقط
model UsedMaterial {
  id          String   @id @default(cuid())
  projectId   String   // المشروع
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId  String   // المادة
  material    Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantity    Float    @default(0) // الكمية المستعملة (Float لدعم الكسور مثل 1.5 متر)
  price       Float    @default(0) // سعر الوحدة وقت الاستخدام
  department  String?  // القسم المستخدم (CARPENTER, PAINTER, إلخ)
  notes       String?  // ملاحظات
  transactionId String? // ربط بحركة المخزون التلقائية
  addedById   String   // من أضاف المادة المستعملة (الستور كيبر)
  addedBy     User     @relation(fields: [addedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([materialId])
  @@index([addedById])
  @@index([department])
}

// حركات المخزون - سجل كامل لكل دخول/خروج للمادة (مثل Sheet1 في ملف STOCK DETAILS)
// كل حركة: تاريخ، كود المادة، الوصف، الوحدة، الكمية (دخل/خرج)، السعر، القسم، الرصيد بعد الحركة
model StockTransaction {
  id            String   @id @default(cuid())
  materialId    String?  // المادة (اختياري - قد تكون حركة لمادة غير مسجلة بعد)
  material      Material? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  projectId     String?  // المشروع المرتبط (اختياري - للحركات الخاصة بمشاريع)
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  itemCode      String?  // كود المادة (لقطة وقت الحركة)
  description   String?  // وصف المادة (لقطة وقت الحركة)
  uom           String?  // وحدة القياس (Mtr, PCS, SHT, GAL, إلخ)
  date          DateTime @default(now()) // تاريخ الحركة
  deliveryQty   Float    @default(0) // الكمية: موجبة = دخل، سالبة = خرج
  price         Float    @default(0) // سعر الوحدة
  totalPrice    Float    @default(0) // إجمالي القيمة = |deliveryQty| * price
  department    String?  // القسم (CARPENTER, TAILOR WORK, PAINTER, STEEL FABRICATION, GENERAL WORK, PARKE)
  balanceAfter  Float?   // الرصيد بعد هذه الحركة (PHYSICAL LIST)
  type          String   @default("delivery") // delivery (دخل), usage (استخدام), adjustment (تسوية), opening (رصيد افتتاحي), return (مرتجع)
  notes         String?  // ملاحظات
  reference     String?  // مرجع (رقم فاتورة، رقم إشعار، إلخ)
  createdById   String?  // من سجّل الحركة
  createdAt     DateTime @default(now())

  @@index([materialId])
  @@index([projectId])
  @@index([date])
  @@index([department])
  @@index([type])
  @@index([itemCode])
}

// سجل التغييرات - لتتبع تعديلات المشرفين
model ChangeLog {
  id          String   @id @default(cuid())
  projectId   String   // المشروع المعدل
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String   // من قام بالتعديل
  user        User     @relation(fields: [userId], references: [id])
  action      String   // نوع التعديل: create, update, delete
  entity      String   // الكيان المعدل: project, item, stage, etc.
  entityId    String?  // معرف الكيان
  changes     String?  // وصف التغييرات (JSON)
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([userId])
  @@index([createdAt])
}

// الإشعارات - تنبيهات للمدير التنفيذي والمدير العام عن تغييرات المشرفين
model Notification {
  id          String   @id @default(cuid())
  userId      String   // المستلم
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?  // المشروع المتعلق (اختياري)
  project     Project? @relation(fields: [projectId], references: [id])
  title       String   // عنوان الإشعار
  message     String   // محتوى الإشعار
  type        String   @default("info") // info, warning, change, approval
  isRead      Boolean  @default(false) // هل تم قراءة الإشعار
  changeLogId String?  // ربط بسجل التغييرات (اختياري)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// المحادثات
model Conversation {
  id          String   @id @default(cuid())
  name        String?  // اسم المحادثة (للمجموعات)
  type        String   @default("DIRECT") // DIRECT, GROUP, BROADCAST
  image       String?  // صورة المحادثة
  createdBy   String?  // من أنشأ المحادثة
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([type])
  @@index([createdAt])
}

// مشاركو المحادثة
model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime? // آخر مرة قرأ فيها المستخدم الرسائل
  joinedAt       DateTime @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

// الرسائل
model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String?  // محتوى الرسالة النصية
  messageType    String   @default("TEXT") // TEXT, IMAGE, FILE, VOICE
  fileUrl        String?  // رابط الملف أو الصورة (base64)
  fileName       String?  // اسم الملف
  fileSize       Int?     // حجم الملف
  isDeleted      Boolean  @default(false) // هل تم حذف الرسالة
  createdAt      DateTime @default(now())

  reads MessageRead[]

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

// قراءة الرسائل
model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}
